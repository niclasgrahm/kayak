      "id": "broken_webhook",
      "inputs": [
        {
          "type": "pipeline",
          "upstream": "heartbeat"
        }
      ],
      "transforms": [
        {
          "type": "http",
          "url": "http://127.0.0.1:59999/alerts",
          "verb": "POST"
        }
      ],
      "outputs": [
        {
          "type": "stdout"
        }
      ]
    },
    {
      "id": "broken_intermittently",
      "inputs": [
        {
          "type": "pipeline",
          "upstream": "heartbeat"
        }
      ],
      "transforms": [
        {
          "type": "filter",
          "conditions": [
            {
              "type": "numeric",
              "field": "value",
